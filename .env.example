# Copy this file to .env.local, fill in real values, then symlink .env to
# it so cmailer's loader (cmailer/src/env.ts) picks it up automatically:
#
#   cp .env.example .env.local
#   ln -s .env.local .env
#
# Both .env and .env.local are gitignored — never commit real credentials.
# `cmailer` also reads .env.local directly if .env doesn't exist, so the
# symlink step is a convenience, not a requirement.
#
# Full setup instructions (creating the OAuth2 client, obtaining a refresh
# token for a CEGAANA Google Workspace account): docs/setup-google-workspace.md

# --- Google Workspace transport (cmailer --transport google-workspace) ---
# The CEGAANA Workspace account cmailer sends as, and the OAuth2 client
# secret + refresh token used to authenticate as that account. All four are
# required together — each also has a --google-* CLI flag that overrides it.

MAILER_GOOGLE_USER_EMAIL=events@cegaana.org
MAILER_GOOGLE_CLIENT_ID=
MAILER_GOOGLE_CLIENT_SECRET=
MAILER_GOOGLE_REFRESH_TOKEN=

# --- Optional defaults (both have CLI flag equivalents: --transport, --out-dir) ---

# MAILER_TRANSPORT=local-file
# MAILER_OUT_DIR=./data/outbox
